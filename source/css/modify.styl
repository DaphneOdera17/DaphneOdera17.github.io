@import 'nib'

// 顶部图
#page-header
  &, &:before
    background: transparent !important
  &.post-bg, &.not-home-page
    height: 280px !important
  #post-info
    bottom: 40px !important
  #page-site-info
    top: 140px !important

  @media screen and (max-width: 768px)
    &.not-home-page
      height: 200px !important
    #post-info
      bottom: 10px !important
    #page-site-info
      top: 100px !important

.top-img
  height: 250px
  margin: -50px -40px 50px
  border-top-left-radius: inherit
  border-top-right-radius: inherit
  background-position: center center
  background-size: cover
  transition: all 0.3s

  @media screen and (max-width: 768px)
    height: 230px
    margin: -36px -14px 36px

  [data-theme='dark'] &
    filter: brightness(0.8)

// 页脚
#footer:before
  background-color: alpha(#FFF, .5)

  [data-theme='dark'] &
    background-color: alpha(#000, .5)

#footer-wrap, #footer-wrap a
  color: #111
  transition: unset

  [data-theme='dark'] &
    color: var(--light-grey)

// 正文阅读字号
#article-container
  font-size: 15px
  line-height: 1.9

  p, li
    line-height: 1.9

  @media screen and (max-width: 768px)
    font-size: 15px
    line-height: 1.85

// 电子杂志页面
#page
  --ink-paper: rgba(250, 249, 244, .92)
  --ink-line: rgba(32, 32, 28, .14)
  --ink-text: #1f211d
  --ink-muted: rgba(31, 33, 29, .62)
  --ink-accent: #2f6f73

.ink-page, .music-hub
  margin: 0 auto
  max-width: 1240px
  color: var(--font-color)

#page:has(.ink-page),
#page:has(.music-hub)
  max-width: 1440px
  width: calc(100% - 32px)
  padding: 26px 34px 40px

  @media screen and (max-width: 768px)
    width: calc(100% - 18px)
    padding: 22px 16px 30px

[data-theme='dark'] #page
  --ink-paper: rgba(25, 27, 25, .86)
  --ink-line: rgba(238, 235, 224, .16)
  --ink-text: #e9e5d8
  --ink-muted: rgba(233, 229, 216, .62)
  --ink-accent: #8fc9c1

.ink-hero
  position: relative
  overflow: hidden
  display: grid
  grid-template-columns: minmax(0, 1fr) 260px
  gap: 34px
  align-items: end
  min-height: 250px
  margin: 0 0 30px
  padding: 36px 40px
  border: 1px solid var(--ink-line)
  border-radius: 8px
  background:
    radial-gradient(circle at 18% 28%, rgba(47, 111, 115, .22), transparent 34%),
    radial-gradient(circle at 82% 18%, rgba(154, 82, 72, .18), transparent 30%),
    repeating-radial-gradient(circle at 52% 44%, transparent 0 16px, rgba(31, 33, 29, .07) 17px 18px),
    linear-gradient(135deg, rgba(250, 249, 244, .94), rgba(229, 232, 224, .86))
  color: var(--ink-text)

  [data-theme='dark'] &
    background:
      radial-gradient(circle at 18% 28%, rgba(143, 201, 193, .16), transparent 34%),
      radial-gradient(circle at 82% 18%, rgba(179, 114, 92, .14), transparent 30%),
      repeating-radial-gradient(circle at 52% 44%, transparent 0 16px, rgba(233, 229, 216, .08) 17px 18px),
      linear-gradient(135deg, rgba(25, 27, 25, .96), rgba(35, 38, 34, .9))

  @media screen and (max-width: 768px)
    grid-template-columns: 1fr
    min-height: 240px
    padding: 30px 24px

.ink-hero__grain
  position: absolute
  inset: 0
  background-image:
    linear-gradient(rgba(255,255,255,.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.08) 1px, transparent 1px)
  background-size: 22px 22px
  mix-blend-mode: overlay
  opacity: .5
  pointer-events: none

.ink-hero__content
  position: relative
  z-index: 1
  max-width: 760px

.ink-hero__aside
  position: relative
  z-index: 1
  align-self: stretch
  display: flex
  flex-direction: column
  justify-content: flex-end
  gap: 10px
  padding-left: 24px
  border-left: 1px solid var(--ink-line)
  color: var(--ink-muted)
  font-family: "SFMono-Regular", Consolas, monospace

  span, em
    font-size: .78rem
    font-style: normal
    text-transform: uppercase

  strong
    color: var(--ink-text)
    font-family: "Noto Serif SC", "Songti SC", serif
    font-size: 1.1rem

  @media screen and (max-width: 768px)
    padding-left: 0
    padding-top: 18px
    border-left: 0
    border-top: 1px solid var(--ink-line)

.ink-kicker
  margin: 0 0 18px
  font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace
  font-size: .78rem
  letter-spacing: .08em
  color: var(--ink-muted)
  text-transform: uppercase

.ink-title
  margin: 0
  max-width: 760px
  font-family: "Playfair Display", "Noto Serif SC", "Songti SC", serif
  font-size: 2.7rem
  line-height: 1.08
  font-weight: 600

  @media screen and (max-width: 768px)
    font-size: 2.25rem

.ink-lede
  max-width: 650px
  margin: 20px 0 0
  color: var(--ink-muted)
  font-size: 1.05rem

.ink-board
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 14px
  margin: 24px 0

  @media screen and (max-width: 768px)
    grid-template-columns: 1fr

.ink-card
  min-height: 150px
  padding: 22px
  border: 1px solid var(--ink-line)
  border-radius: 8px
  background: var(--ink-paper)

.ink-card__num
  font-family: "SFMono-Regular", Consolas, monospace
  color: var(--ink-accent)
  font-size: .78rem

.ink-card h2
  margin: 34px 0 8px
  font-family: "Playfair Display", "Noto Serif SC", serif
  font-size: 1.45rem

.ink-card p
  margin: 0
  color: var(--ink-muted)

.ink-list
  margin-top: 18px
  border-top: 1px solid var(--ink-line)

.ink-list__row
  display: grid
  grid-template-columns: 92px 1fr 72px
  gap: 18px
  align-items: center
  padding: 18px 0
  border-bottom: 1px solid var(--ink-line)

  @media screen and (max-width: 768px)
    grid-template-columns: 1fr
    gap: 6px

.ink-list__row span,
.ink-list__row em
  font-family: "SFMono-Regular", Consolas, monospace
  color: var(--ink-muted)
  font-size: .78rem
  font-style: normal

.ink-list__row strong
  font-family: "Noto Serif SC", "Songti SC", serif
  font-size: 1.1rem

// 音乐页
.music-hub
  max-width: 1240px

.music-panel
  display: grid
  grid-template-columns: 140px 1fr
  gap: 28px
  margin: 22px 0
  padding: 22px
  border: 1px solid var(--ink-line)
  border-radius: 8px
  background: var(--ink-paper)

  @media screen and (max-width: 768px)
    grid-template-columns: 1fr
    gap: 12px

.music-panel--primary
  margin-top: 0

.music-panel__meta
  display: flex
  flex-direction: column
  gap: 10px
  color: var(--ink-muted)
  font-family: "SFMono-Regular", Consolas, monospace
  font-size: .78rem
  text-transform: uppercase

.music-panel__body
  display: grid
  grid-template-columns: minmax(180px, 260px) 1fr
  gap: 22px
  align-items: start

  @media screen and (max-width: 900px)
    grid-template-columns: 1fr

.music-panel h2
  margin: 0 0 8px
  font-family: "Playfair Display", "Noto Serif SC", serif
  font-size: 1.6rem

.music-panel p
  margin: 0
  color: var(--ink-muted)

.papers-board
  grid-template-columns: 1.2fr 1fr 1fr

  @media screen and (max-width: 768px)
    grid-template-columns: 1fr

.papers-list
  margin-top: 26px

.music-hub__embed
  overflow: hidden
  border: 1px solid var(--ink-line)
  border-radius: 8px
  background: rgba(127, 127, 127, .08)

.music-hub iframe
  display: block
  width: 100%
  border: 0

// 说说页
#essay_page .essayPage
  position: relative
  overflow: hidden
  min-height: 260px
  margin-bottom: 26px
  border: 1px solid var(--ink-line)
  border-radius: 8px
  background:
    radial-gradient(circle at 24% 20%, rgba(47, 111, 115, .22), transparent 34%),
    repeating-linear-gradient(115deg, transparent 0 18px, rgba(127,127,127,.08) 19px 20px),
    var(--ink-paper)

#essay_page .essayPage:before
  content: "NOTES / MOMENTS / FIELD LOG"
  position: absolute
  left: 28px
  top: 28px
  font-family: "SFMono-Regular", Consolas, monospace
  font-size: .78rem
  color: var(--ink-muted)

#essay_page .essayPage:after
  content: "个人随想录"
  position: absolute
  left: 28px
  bottom: 34px
  max-width: 560px
  font-family: "Playfair Display", "Noto Serif SC", serif
  font-size: 2.4rem
  line-height: 1.1
  color: var(--ink-text)

#bber .timeline ul li.bber-item
  border: 1px solid var(--ink-line)
  border-radius: 8px
  background: var(--ink-paper)
  box-shadow: none

#bber .bber-content .datacont
  font-family: "Noto Serif SC", "Songti SC", serif
  font-size: 1.05rem
  line-height: 1.85

#bber .bber-info-time,
#bber .bber-info-from
  font-family: "SFMono-Regular", Consolas, monospace

// 13/14 寸笔记本适配
@media screen and (max-width: 1600px) and (min-width: 901px)
  #content-inner.layout
    max-width: 1180px
    padding: 32px 18px

  #content-inner.layout > div:first-child
    min-width: 0

  #content-inner.layout > #recent-posts
    width: calc(100% - 292px) !important

  #aside-content,
  .aside-content
    min-width: 250px
    max-width: 270px
    margin-left: 18px !important
    font-size: .94em

  #aside-content .card-widget
    padding: 18px 20px

  #aside-content .card-info .author-info__name
    font-size: 1.18em

  #aside-content .card-info .author-info__description
    font-size: .9em

  #aside-content .card-info .card-info-data
    font-size: .9em

  #recent-posts
    gap: 18px
    justify-content: flex-start !important
    margin-top: 0 !important
    font-size: .94em

  #recent-posts > .recent-post-item
    width: calc(50% - 9px) !important
    margin-top: 0 !important

  #recent-posts > .recent-post-item .post_cover
    height: 150px !important

  .recent-post-info
    padding: 0 22px 16px !important
    font-size: .94em

  #recent-posts > .recent-post-item > .recent-post-info > .article-title
    font-size: .98em !important
    line-height: 1.38 !important

  #recent-posts > .recent-post-item > .recent-post-info > .content
    font-size: .92em
    line-height: 1.75

  #recent-posts > .recent-post-item > .recent-post-info > .article-meta-wrap
    font-size: .78em !important
    margin-bottom: .7rem !important

  #page:has(.ink-page),
  #page:has(.music-hub)
    max-width: 1180px
    width: calc(100% - 28px)
    padding: 24px 28px 36px

  .ink-page, .music-hub
    max-width: 1080px

  .ink-hero
    grid-template-columns: minmax(0, 1fr) 220px
    gap: 24px
    min-height: 220px
    padding: 30px 34px

  .ink-title
    font-size: 2.35rem
    max-width: 680px

  .ink-lede
    max-width: 560px
    font-size: 1rem

  .ink-board
    gap: 12px

  .ink-card
    min-height: 138px
    padding: 18px

  .ink-card h2
    margin-top: 24px
    font-size: 1.32rem

  .music-panel
    grid-template-columns: 112px 1fr
    gap: 20px
    padding: 18px

  .music-panel__body
    grid-template-columns: minmax(150px, 210px) 1fr
    gap: 18px

  .music-hub iframe
    height: 390px

  .music-hub__embed:not(.music-hub__embed--apple) iframe
    height: 320px

  .papers-board
    grid-template-columns: repeat(3, minmax(0, 1fr))

@media screen and (max-width: 1180px) and (min-width: 901px)
  #content-inner.layout
    max-width: 980px

  #content-inner.layout > #recent-posts
    width: 100% !important

  #aside-content,
  .aside-content
    display: none

  #recent-posts > .recent-post-item
    width: 100% !important
    display: flex
    flex-direction: row

  #recent-posts > .recent-post-item .post_cover
    width: 38% !important
    height: 210px !important

  #recent-posts > .recent-post-item > .recent-post-info
    width: 62% !important
    padding: 0 28px !important

  #recent-posts > .recent-post-item > .recent-post-info > .article-title
    font-size: 1.14em !important

  #page:has(.ink-page),
  #page:has(.music-hub)
    max-width: 980px
    padding: 22px 24px 34px

  .ink-hero
    grid-template-columns: 1fr
    min-height: 210px

  .ink-hero__aside
    padding-left: 0
    padding-top: 16px
    border-left: 0
    border-top: 1px solid var(--ink-line)

  .music-panel
    grid-template-columns: 1fr

  .music-panel__meta
    flex-direction: row
    justify-content: space-between

  .music-panel__body
    grid-template-columns: 1fr

// 小屏适配
html, body
  max-width: 100%
  overflow-x: hidden

#article-container
  img, video, iframe, table
    max-width: 100%

  table
    display: block
    overflow-x: auto

  pre
    max-width: 100%
    overflow-x: auto

@media screen and (max-width: 600px)
  #content-inner.layout
    padding: 0 10px

  #page
    border-radius: 8px

  #page:has(.ink-page),
  #page:has(.music-hub)
    width: calc(100% - 12px)
    padding: 14px 10px 24px

  .ink-page, .music-hub
    max-width: 100%

  .ink-hero
    min-height: auto
    margin-bottom: 18px
    padding: 22px 18px
    border-radius: 8px
    gap: 18px

  .ink-kicker
    margin-bottom: 12px
    font-size: .7rem
    line-height: 1.4

  .ink-title
    font-size: 1.78rem
    line-height: 1.14
    overflow-wrap: anywhere

  .ink-lede
    margin-top: 14px
    font-size: .95rem
    line-height: 1.7

  .ink-hero__aside
    gap: 6px
    padding-top: 14px

  .ink-board
    gap: 10px
    margin: 16px 0

  .ink-card
    min-height: 128px
    padding: 18px

  .ink-card h2
    margin-top: 22px
    font-size: 1.25rem

  .ink-list__row
    padding: 14px 0

  .music-panel
    margin: 14px 0
    padding: 16px
    gap: 14px

  .music-panel__meta
    flex-direction: row
    justify-content: space-between

  .music-panel__body
    gap: 14px

  .music-panel h2
    font-size: 1.28rem

  .music-hub iframe
    height: 360px

  .music-hub__embed:not(.music-hub__embed--apple) iframe
    height: 300px

  #essay_page .essayPage
    min-height: 190px
    margin-bottom: 18px

  #essay_page .essayPage:before
    left: 20px
    top: 20px
    font-size: .68rem

  #essay_page .essayPage:after
    left: 20px
    right: 20px
    bottom: 24px
    font-size: 1.85rem

  #bber
    padding: 0

  #bber .timeline ul li.bber-item
    width: 100% !important
    margin: 0 0 14px !important
    padding: 14px

  #bber .bber-content .datacont
    font-size: 1rem
    line-height: 1.75

  #bber .bber-info
    flex-wrap: wrap
    gap: 8px

  #footer-wrap
    padding: 26px 16px

@media screen and (max-width: 380px)
  .ink-title
    font-size: 1.55rem

  .music-hub iframe
    height: 320px

  .music-hub__embed:not(.music-hub__embed--apple) iframe
    height: 280px
